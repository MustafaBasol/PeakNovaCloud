{
  "name": "PeakNova",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:production": "sh ./scripts/start-production.sh",
    "lint": "eslint .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:reset": "docker compose down -v && docker compose up -d postgres",
    "deploy:prepare": "sh ./scripts/prepare-deployment.sh",
    "deploy:up": "docker compose -f compose.production.yml --env-file .env.production up -d --build",
    "deploy:down": "docker compose -f compose.production.yml --env-file .env.production down --remove-orphans",
    "deploy:reset": "docker compose -f compose.production.yml --env-file .env.production down -v --remove-orphans",
    "deploy:logs": "docker compose -f compose.production.yml --env-file .env.production logs -f",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:push:local": "DATABASE_URL='postgresql://postgres:postgres@localhost:5432/peaknova?schema=public' prisma db push",
    "prisma:generate:local": "DATABASE_URL='postgresql://postgres:postgres@localhost:5432/peaknova?schema=public' prisma generate",
    "db:seed": "node prisma/seed.js",
    "db:seed:local": "DATABASE_URL='postgresql://postgres:postgres@localhost:5432/peaknova?schema=public' node prisma/seed.js",
    "content:refresh": "node prisma/refresh-content.js",
    "content:validate": "node prisma/validate-content.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@radix-ui/react-form": "^0.1.16",
    "@radix-ui/react-toast": "^1.2.23",
    "cookie": "^1.0.2",
    "dotenv": "^16.4.5",
    "framer-motion": "^13.2.0",
    "html-react-parser": "^5.1.18",
    "js-cookie": "^3.0.5",
    "jsonwebtoken": "^9.0.2",
    "next": "^16.3.4",
    "next-intl": "^4.14.2",
    "nodemailer": "^6.9.14",
    "pg": "^8.20.0",
    "prisma": "^7.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.2.1"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.3"
  }
}
